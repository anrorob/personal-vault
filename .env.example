# Docker Compose interpolation only. Copy to .env for a local development tree.
# Backend/database runtime values belong in config/auth.env and config/database.env.

# Logical host-side storage roots. These are not production defaults.
PV_VAULT_ROOT=./vault
PV_STORAGE_SLOT_ROOT=./storage-slots

# Optional model-service roots and hardware settings used by docker-compose.yml.
PV_FLORENCE_MODEL_ROOT=./models/florence2
PV_RAMPP_MODEL_ROOT=./models/rampp
PV_PEOPLE_MODEL_ROOT=./models/people
PV_FACE_DETECTOR_MODEL_ROOT=./models/face-detector
PV_FLORENCE_DEVICE=CPU
PV_RENDER_GID=992

# Public identification for optional MusicBrainz requests.
PV_MUSICBRAINZ_USER_AGENT="PersonalVault/0.1 (self-hosted development instance)"

# Optional explicit managed-slot map. Leave as an empty JSON object for a
# development setup without commissioned storage slots.
PV_STORAGE_SLOT_ROOTS_JSON={}
