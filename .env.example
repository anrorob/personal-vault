# Copy to .env and replace every placeholder before running a real instance.
POSTGRES_DB=personal_vault
POSTGRES_USER=pvadmin
POSTGRES_PASSWORD=replace-with-a-long-unique-password
PV_ADMIN_USERNAME=admin
PV_ADMIN_PASSWORD_HASH=replace-with-an-argon2-password-hash
PV_SESSION_SECRET=replace-with-a-long-random-session-secret
PV_WEBAUTHN_RP_ID=vault.example.test
PV_WEBAUTHN_ORIGIN=https://vault.example.test
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=replace-with-a-jellyfin-api-key
PV_STORAGE_SLOT_ROOT=./storage-slots
PV_VAULT_ROOT=./vault
PV_FLORENCE_MODEL_ROOT=./models/florence2
PV_RAMPP_MODEL_ROOT=./models/rampp
PV_PEOPLE_MODEL_ROOT=./models/people
PV_FACE_DETECTOR_MODEL_ROOT=./models/face-detector
