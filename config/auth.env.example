# Copy to config/auth.env. Do not commit the real file.

# First administrator. PV_ADMIN_PASSWORD_HASH must be a real Argon2 hash, not
# a plaintext password or this placeholder.
PV_ADMIN_USERNAME=admin
PV_ADMIN_PASSWORD_HASH=replace-with-an-argon2-password-hash

# Generate a long, random value unique to this instance.
PV_SESSION_SECRET=replace-with-a-long-random-session-secret

# Passkeys require HTTPS. The RP ID is a hostname and must exactly match the
# hostname in PV_WEBAUTHN_ORIGIN.
PV_WEBAUTHN_RP_ID=vault.example.test
PV_WEBAUTHN_ORIGIN=https://vault.example.test

# Required by the current backend configuration, including setups that do not
# yet import media from Jellyfin. Use a development-only service/key.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=replace-with-a-jellyfin-api-key

# Optional workers deny admission unless the exact deployed identity is authorized.
PV_ALLOWED_SOURCE_REPOSITORIES=anrorob/personal-vault
# Supplier payload listener requires an explicit exact-host allowlist.
# PV_VAULT_SUPPLIER_LAN_ALLOWED_HOSTS=vault-server.local,backup-vault.local
# Jellyfin mapping is OPTIONAL when both services already see identical paths.
# Leave the key absent for literal lookup. An empty value is INVALID.
# PV_JELLYFIN_MEDIA_PATH_MAP_JSON=[{"section":"movies","pv_root":"/media/movies","jellyfin_root":"/media/movies"},{"section":"tv","pv_root":"/media/tv","jellyfin_root":"/media/tv"}]
